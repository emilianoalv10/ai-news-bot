# Anthropic API key (https://console.anthropic.com)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Viva Engage / Yammer token (https://www.yammer.com/client_applications)
VIVA_ENGAGE_TOKEN=your_viva_engage_token_here

# Optional: Viva Engage group/community ID to post to (leave empty for default feed)
VIVA_ENGAGE_GROUP_ID=
